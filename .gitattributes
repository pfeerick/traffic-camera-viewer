# Default: normalise line endings to LF in the repository,
# check out as LF on all platforms.
* text=auto eol=lf

# Source and config files — always LF
*.rs      text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.sh      text eol=lf
*.ts      text eol=lf
*.svelte  text eol=lf
*.css     text eol=lf
*.html    text eol=lf

# Windows scripts — CRLF on checkout
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binaries — no line-ending processing
*.jpg     binary
*.jpeg    binary
*.png     binary
*.ico     binary
*.icns    binary
*.exe     binary

# Generated lockfiles — exclude from diffs/linguist stats
bun.lock     linguist-generated=true
Cargo.lock   linguist-generated=true
