{
  "name": "traffic-camera-viewer",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "server": "bun server/index.ts",
    "check": "biome check . && prettier --check \"src/**/*.svelte\"",
    "check:fix": "biome check --write . && prettier --write \"src/**/*.svelte\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json && tsc -p server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.2",
    "@types/bun": "1.3.14",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.56.1",
    "svelte-check": "^4.5.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1"
  }
}
